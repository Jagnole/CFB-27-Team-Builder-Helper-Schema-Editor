<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:CfbUniformEditorPlugin"
    xmlns:tc="clr-namespace:CfbUniformEditorPlugin.TeamCreator"
    xmlns:core="clr-namespace:Frosty.Core.Controls;assembly=FrostyCore"
    xmlns:ctrl="clr-namespace:Frosty.Controls;assembly=FrostyControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/FrostyControls;component/Themes/Generic.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- FrostyUniformEditor: property grid on the left, live preview viewport on the right -->
    <Style TargetType="{x:Type local:FrostyUniformEditor}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:FrostyUniformEditor}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>

                        <ctrl:FrostyDockablePanel Grid.Column="0" Title="Properties" Icon="/FrostyEditor;component/Images/Properties.png">
                            <core:FrostyPropertyGrid x:Name="PART_AssetPropertyGrid"
                                                      Asset="{Binding Asset, RelativeSource={RelativeSource TemplatedParent}}"
                                                      Modified="{Binding AssetModified, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </ctrl:FrostyDockablePanel>

                        <GridSplitter Background="Transparent" VerticalAlignment="Stretch" Width="3" ResizeDirection="Columns"/>

                        <ctrl:FrostyDockablePanel Grid.Column="1" Title="Live Preview">
                            <core:FrostyViewport x:Name="PART_Renderer"/>
                        </ctrl:FrostyDockablePanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TeamCreatorTabItem: form on top (base team, brand fields, texture slots), log at the bottom -->
    <Style TargetType="{x:Type tc:TeamCreatorTabItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type tc:TeamCreatorTabItem}">
                    <Grid Background="{StaticResource ControlBackground}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="140"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Base team" FontWeight="Bold" Margin="0,0,0,4" Foreground="{StaticResource FontColor}"/>
                                <TextBlock Text="Texture-suffix code (e.g. sanjosestate) -- find this from any existing tmlg_ncaa_primary_&lt;code&gt; asset name." Foreground="{StaticResource FontColor}" Opacity="0.7" TextWrapping="Wrap"/>
                                <TextBox x:Name="PART_BaseTeamCode" Margin="0,2,0,8"/>
                                <TextBlock Text="TeamVisuals asset path (e.g. content/footballcharacter/teamvisuals/sanjos_teamvisuals) -- right-click it in the Data Explorer and Copy Path." Foreground="{StaticResource FontColor}" Opacity="0.7" TextWrapping="Wrap"/>
                                <TextBox x:Name="PART_BaseTeamVisualsPath" Margin="0,2,0,12"/>

                                <TextBlock Text="Team identity" FontWeight="Bold" Margin="0,0,0,4" Foreground="{StaticResource FontColor}"/>
                                <TextBlock Text="Team name (AssetName)" Foreground="{StaticResource FontColor}" Opacity="0.7"/>
                                <TextBox x:Name="PART_TeamName" Margin="0,2,0,8"/>
                                <TextBlock Text="Prefix name (PrefixName)" Foreground="{StaticResource FontColor}" Opacity="0.7"/>
                                <TextBox x:Name="PART_PrefixName" Margin="0,2,0,8"/>
                                <TextBlock Text="Brand name (BrandName)" Foreground="{StaticResource FontColor}" Opacity="0.7"/>
                                <TextBox x:Name="PART_BrandName" Margin="0,2,0,12"/>

                                <TextBlock Text="Logos &amp; UI art" FontWeight="Bold" Margin="0,0,0,4" Foreground="{StaticResource FontColor}"/>
                                <TextBlock Text="Leave any slot blank to skip it." Foreground="{StaticResource FontColor}" Opacity="0.7" Margin="0,0,0,4"/>
                                <StackPanel x:Name="PART_TextureSlotsPanel"/>

                                <Button x:Name="PART_CreateButton" Content="Create Team" Margin="0,14,0,0" Padding="12,6" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="1" Background="{StaticResource ListBackground}" BorderBrush="{StaticResource ControlBackground}" BorderThickness="0,1,0,0">
                            <TextBox x:Name="PART_Log" IsReadOnly="True" Margin="4" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
